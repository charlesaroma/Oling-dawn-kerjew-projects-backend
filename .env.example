# Copy this file to `.env` and fill in real values.

# MongoDB Atlas connection string (needs a replica set — Atlas provides one
# automatically; a bare local `mongod` will not work with $transaction).
MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/oling-dawn-kerjew?retryWrites=true&w=majority"

PORT=5001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""

# From your ImageKit dashboard (Developer Options).
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
